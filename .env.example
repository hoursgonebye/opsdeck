# Copy to .env and fill in. docker compose reads .env automatically.
OPSDECK_TOKEN=replace-me-with-a-long-random-string
OPSDECK_TZ=America/New_York
OPSDECK_MAX_UPLOAD_MB=25

# Optional - enables the in-app mentor. Leave blank to use queue mode
# (Claude Code picks up pending attempts via the API instead).
ANTHROPIC_API_KEY=
OPSDECK_MENTOR_MODEL=claude-sonnet-4-6

# The notes gate: a level-up attempt refuses to open unless the attached
# Docs writeup has at least this many characters. Raise it to make the
# mentor's floor stricter.
OPSDECK_NOTES_MIN_CHARS=300

# Subscribed calendar feeds (Calendar -> Feeds) refetch themselves once they
# are this many minutes stale, so a work roster stays current without anyone
# pressing "Sync all". Set to 0 to turn the background sweeper off and keep
# feeds manual-only.
OPSDECK_FEED_SYNC_MINUTES=60

# When the mentor's nightly briefing is written (local time, HH:MM). A
# deterministic digest of the day - schedule, money, routines, skills -
# stored in Docs > Briefings so the chat mentor starts each day informed
# without spending tokens to find out. Empty disables it.
OPSDECK_BRIEFING_TIME=23:45

# Cashflow guard: if liquid balance (checking+cash) minus recurring charges
# due in the next 14 days drops below this many cents, the nightly pass
# sends a warning notification (pushed to phones if subscribed). 0 disables.
OPSDECK_LOW_BALANCE_CENTS=2500

# Web Push contact claim sent to browser push services (any mailto: you
# own). The VAPID keypair itself is generated automatically on first use
# and persisted at data/vapid_private.pem - don't delete it, or every
# device has to re-subscribe.
OPSDECK_VAPID_SUB=mailto:you@example.com

# Where the mentor chat sidecar lives. Only change this if you renamed the
# terminal service or run it off the shared docker network.
OPSDECK_BRIDGE_URL=http://terminal:7682

# TryHackMe public profile username can be set in the UI (TryHackMe tab)
# and lives in the database, not here.

# ---- Health (optional) ----
# Connects Fitbit / Pixel Watch data via the Google Health API.
#
# NOTE: the legacy Fitbit Web API sunsets 2026-09-30. This integration
# targets its replacement, the Google Health API, so it does not need
# rewriting in September.
#
# Register at https://console.cloud.google.com:
#   1. New project -> enable the Health API
#   2. OAuth consent screen -> External -> add yourself as a Test user
#      (Testing mode avoids Google's app-verification review, which
#      health scopes otherwise require. Fine for a personal instance.)
#   3. Credentials -> OAuth client ID -> Web application
#   4. Authorised redirect URI must match OPSDECK_GOOGLE_REDIRECT_URI below
OPSDECK_GOOGLE_CLIENT_ID=
OPSDECK_GOOGLE_CLIENT_SECRET=
OPSDECK_GOOGLE_REDIRECT_URI=https://opsdeck.example.ts.net/api/health/callback
